# Each lifecycle function runs as its own script: no shared helpers, every step is written out.
# Never `systemctl stop xochitl`: that powers the Paper Pro off. Scripts never restart xochitl themselves: they re-arm
# the transient timer rmpp-restart-xochitl (15 s, runs /usr/lib/rmpp/restart), so a transaction restarts it once.
# Root file system: everything under /usr/lib/rmpp (rmpp-preload's layout, the same as rmpp-studio's Tablet >
# Install and the former rmpp-install.sh, so this package takes over such an install); a file in use is renamed to
# *.old or moved to /usr/lib/rmpp/.trash, never deleted, and /usr/lib/rmpp/restart deletes it after the restart.
# Plain `mount -o remount,rw|ro /`: Vellum's mount-rw unmounts /etc recursively, which also drops the
# /etc/dropbear bind mount (SSH host key) until the next boot.

package() {
	install -Dm755 "$srcdir"/librmpp-remote.so "$pkgdir"/home/root/.vellum/share/rmpp-remote/librmpp-remote.so
	install -Dm755 "$srcdir"/rmpp-remote "$pkgdir"/home/root/.vellum/share/rmpp-remote/rmpp-remote

	install -Dm644 "$srcdir"/LICENSE "$pkgdir"/home/root/.vellum/licenses/$pkgname/LICENSE
	echo "https://github.com/$upstream_author/rmpp-studio" > "$pkgdir"/home/root/.vellum/licenses/$pkgname/SOURCES
}

postinstall() {
	mount -o remount,rw /
	# rmpp-studio 0.3.x (and its old name rmpp-tester) installed to /usr/lib: set aside (deleted after the restart)
	if [ -e /usr/lib/rmpp-remote ]; then
		mkdir -p /usr/lib/rmpp/.trash
		mv /usr/lib/rmpp-remote /usr/lib/rmpp/.trash/usr_lib_rmpp-remote.$$
	fi
	if [ -e /usr/lib/rmpp-tester ]; then
		mkdir -p /usr/lib/rmpp/.trash
		mv /usr/lib/rmpp-tester /usr/lib/rmpp/.trash/usr_lib_rmpp-tester.$$
	fi
	rm -f /usr/lib/rmpp-preload.d/40-rmpp-remote.so /usr/lib/rmpp-preload.d/40-rmpp-tester.so
	rmdir /usr/lib/rmpp-preload.d 2>/dev/null || true
	mkdir -p /usr/lib/rmpp/rmpp-remote /usr/lib/rmpp/preload.d
	cp /home/root/.vellum/share/rmpp-remote/librmpp-remote.so /usr/lib/rmpp/rmpp-remote/librmpp-remote.so.new && chmod 755 /usr/lib/rmpp/rmpp-remote/librmpp-remote.so.new && { [ ! -e /usr/lib/rmpp/rmpp-remote/librmpp-remote.so ] || mv -f /usr/lib/rmpp/rmpp-remote/librmpp-remote.so /usr/lib/rmpp/rmpp-remote/librmpp-remote.so.old; } && mv -f /usr/lib/rmpp/rmpp-remote/librmpp-remote.so.new /usr/lib/rmpp/rmpp-remote/librmpp-remote.so
	cp /home/root/.vellum/share/rmpp-remote/rmpp-remote /usr/lib/rmpp/rmpp-remote/rmpp-remote.new && chmod 755 /usr/lib/rmpp/rmpp-remote/rmpp-remote.new && { [ ! -e /usr/lib/rmpp/rmpp-remote/rmpp-remote ] || mv -f /usr/lib/rmpp/rmpp-remote/rmpp-remote /usr/lib/rmpp/rmpp-remote/rmpp-remote.old; } && mv -f /usr/lib/rmpp/rmpp-remote/rmpp-remote.new /usr/lib/rmpp/rmpp-remote/rmpp-remote
	ln -sfn ../rmpp-remote/librmpp-remote.so /usr/lib/rmpp/preload.d/40-rmpp-remote.so
	# running rmpp-remote programs (rmpp-studio's pointer stream) keep the old binary open: stop them, rmpp-studio
	# reconnects by itself
	pidof rmpp-remote | xargs -r kill 2>/dev/null || true
	sync
	mount -o remount,ro / || echo "note: / stays read-write until xochitl restarts"
	# one xochitl restart per Vellum transaction: (re)arm the timer, so the last package script wins
	systemctl stop rmpp-restart-xochitl.timer 2>/dev/null || true
	systemd-run --quiet --unit=rmpp-restart-xochitl --on-active=15 --timer-property=AccuracySec=1s \
		/bin/sh -c '[ -x /usr/lib/rmpp/restart ] && exec /usr/lib/rmpp/restart; systemctl reset-failed xochitl; systemctl restart xochitl' || \
		{ systemctl reset-failed xochitl 2>/dev/null || true; systemctl restart xochitl; }
}

